# ============================================================
# vipies — konfigurasi credentials (dari .env.example)
# COPY ke .env ATAU set sebagai environment variable sebelum jalankan setup.sh:
#   cp .env.example .env && nano .env
# JANGAN commit .env ke git!
# ============================================================

# ---------- Umum ----------
# Distro target (hanya Ubuntu didukung)
DISTRO_VERSION=24.04

# Versi software (opsional; kosong = pakai default)
NODE_VERSION=22
PHP_VERSION=8.3

# ---------- MySQL root ----------
# Password root MySQL (wajib diisi)
MYSQL_ROOT_PASSWORD=

# ---------- Telegram notif ----------
# Bot token dari @BotFather
TG_BOT_TOKEN=
# Chat ID tujuan notif (bisa chat pribadi atau group)
TG_CHAT_ID=

# ---------- R2 Backup (opsional) ----------
# Set to 1 untuk aktifkan backup ke R2
R2_ENABLED=0
# Nama remote rclone (default r2)
R2_REMOTE_NAME=r2
# Nama bucket R2 (default hermes)
R2_BUCKET=hermes
# --- Credentials R2 (Cloudflare) ---
# Account ID: dari dashboard Cloudflare R2 (subdomain endpoint)
R2_ACCOUNT_ID=
# Access Key ID & Secret dari R2 > Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
